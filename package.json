{
	"name": "neuro-hub",
	"version": "0.4.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typegen": "next typegen",
		"type-check": "tsc --noEmit",
		"lint": "eslint . --ext .ts,.tsx",
		"lint:ci": "eslint . --ext .ts,.tsx --max-warnings 0",
		"lint:fix": "eslint . --ext .ts,.tsx --fix",
		"lint-staged": "lint-staged",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\"",
		"test": "jest --passWithNoTests",
		"test:watch": "jest --watch --passWithNoTests",
		"db:auth:migrate": "yes | better-auth migrate",
		"db:migrate": "tsx scripts/db/migrate.ts",
		"db:migrate:rollback": "tsx scripts/db/migrate-rollback.ts",
		"db:migrate:status": "tsx scripts/db/migrate-status.ts",
		"db:migrate:production": "./scripts/db/migrate-production.sh",
		"db:seed": "NODE_OPTIONS='--import tsx' knex seed:run --knexfile knexfile.ts",
		"db:seed:make": "NODE_OPTIONS='--import tsx' knex seed:make --knexfile knexfile.ts",
		"db:test": "tsx src/lib/db/test-connection.ts",
		"db:generate-types": "kysely-codegen --out-file=src/types/database.ts",
		"db:export": "./scripts/db/export-data.sh",
		"db:import": "./scripts/db/import-data.sh",
		"db:backup:railway": "./scripts/db/backup-railway.sh",
		"db:check": "tsx scripts/db/check-db.ts",
		"db:delete-users": "tsx scripts/db/delete-users.ts",
		"db:reset-email-verification": "tsx scripts/db/reset-email-verification.ts",
		"db:drop-all": "tsx scripts/db/drop-all-tables.ts",
		"db:reset-railway": "./scripts/db/reset-railway.sh",
		"db:reset-railway:force": "./scripts/db/reset-railway.sh --force",
		"prepare": "husky"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@react-email/components": "^1.0.10",
		"@scalar/nextjs-api-reference": "^0.10.3",
		"@tailwindcss/postcss": "^4.2.1",
		"@vercel/blob": "^2.3.1",
		"better-auth": "^1.4.17",
		"chalk": "^5.6.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"dayjs": "^1.11.20",
		"effector": "^23.4.4",
		"effector-react": "^23.3.0",
		"htmlparser2": "^10.1.0",
		"immer": "^11.1.4",
		"knex": "3.1.0",
		"kysely": "^0.28.12",
		"lodash": "^4.17.23",
		"lucide-react": "^0.577.0",
		"next": "^16.1.7",
		"next-swagger-doc": "^0.4.1",
		"patronum": "^2.3.0",
		"pg": "8.20.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-dropzone": "^15.0.0",
		"react-photo-album": "^3.5.1",
		"resend": "^6.9.4",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.21",
		"@jest/test-sequencer": "^30.2.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.2",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25.5.0",
		"@types/pg": "^8.18.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.57.1",
		"@typescript-eslint/parser": "^8.57.1",
		"eslint": "^9.18.0",
		"eslint-config-next": "^16.1.7",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-effector": "^0.17.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"kysely-codegen": "^0.20.0",
		"lint-staged": "^16.4.0",
		"openapi-types": "^12.1.3",
		"prettier": "^3.8.1",
		"prettier-plugin-tailwindcss-canonical-classes": "^0.1.3",
		"shadcn": "^4.0.8",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3"
	},
	"engines": {
		"node": "24.x",
		"yarn": "4.x"
	},
	"packageManager": "yarn@4.13.0"
}
