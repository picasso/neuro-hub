# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/neurogig

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (required for email verification)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=NeuroGig <onboarding@resend.dev>
# EMAIL_REPLY_TO=your-email@example.com

# File Upload (portfolio)
# Vercel Blob token for server-side upload token exchange:
# https://vercel.com/docs/storage/vercel-blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Monitoring
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=

# Payment (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
