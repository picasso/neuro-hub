{
	"mcpServers": {
		"shadcn-ui": {
			"command": "npx",
			"args": ["-y", "shadcn@latest", "mcp"]
		},
		"serena": {
			"command": "uvx",
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"--context",
				"ide",
				"--project-from-cwd"
			]
		}
	}
}
