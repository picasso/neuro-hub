{
	"mcpServers": {
		"Ref": {
			"command": "npx",
			"args": ["-y", "envmcp", "-e", ".env.local", "npx", "-y", "ref-tools-mcp@latest"],
			"env": {}
		},
		"context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"],
			"env": {
				"CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
			}
		},
		"filesystem": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"]
		},
		"firecrawl": {
			"command": "npx",
			"args": ["-y", "envmcp", "-e", ".env.local", "npx", "-y", "firecrawl-mcp"],
			"env": {}
		},
		"github": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
			}
		},
		"memory": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-memory"]
		},
		"postgres": {
			"command": "npx",
			"args": [
				"-y",
				"envmcp",
				"-e",
				".env.local",
				"npx",
				"-y",
				"@modelcontextprotocol/server-postgres",
				"$DATABASE_URL"
			]
		},
		"shadcn-ui": {
			"command": "npx",
			"args": ["-y", "shadcn@latest", "mcp"]
		},
		"serena": {
			"command": "uvx",
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"--context",
				"ide",
				"--project-from-cwd"
			]
		}
	}
}
